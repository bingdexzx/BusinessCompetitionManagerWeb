{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "合同插件 INPUT_SCHEMA（列表）",
  "type": "array",
  "description": "每个元素是一个输入项；type 决定界面控件。",
  "items": {
    "type": "object",
    "required": ["key", "label", "type"],
    "properties": {
      "key": {
        "type": "string",
        "description": "输入键；插件里用 ctx.input(key) / ctx.input_list(key) 读取"
      },
      "label": {
        "type": "string",
        "description": "中文标签（界面显示）"
      },
      "type": {
        "type": "string",
        "description": "NUMBER / TEXT / BOOLEAN / REF:<表> / LIST:<表>",
        "pattern": "^(NUMBER|TEXT|BOOLEAN|BOOL|(REF|LIST):(materials|parts|products|map_nodes|cities|vehicles|companies|regions|fuels|tech_nodes|infrastructures|warehouses|production_lines))$"
      },
      "optional": {
        "type": "boolean",
        "description": "仅 LIST 有意义：整项可以留空（界面标「选填」）"
      },
      "itemLabel": {
        "type": "string",
        "description": "清单里每个条目的中文名（如 原料、零件、地点）"
      },
      "fields": {
        "type": "array",
        "description": "清单行内字段；空数组 = 只登记条目（不填数量）",
        "items": {
          "type": "object",
          "required": ["key", "label", "type"],
          "properties": {
            "key": {"type": "string", "description": "行字段键，如 quantity"},
            "label": {"type": "string", "description": "行字段中文名"},
            "type": {"type": "string", "enum": ["NUMBER"], "description": "目前仅支持 NUMBER"},
            "min": {"type": "number", "description": "最小值"},
            "max": {"type": "number", "description": "最大值"}
          },
          "additionalProperties": false
        }
      },
      "min": {"type": "number", "description": "数值输入的最小值"},
      "max": {"type": "number", "description": "数值输入的最大值"}
    },
    "additionalProperties": false
  }
}
