## 示例配置文件

## 数据库配置
DATABASES_NAME = ''
DATABASES_USER = 'postgres'
DATABASES_PASSWORD = ''
DATABASES_HOST = 'localhost'
DATABASES_PORT = '5432'

## 数据库连接层（可选，默认见 settings/databases.py）
# DATABASES_CONN_MAX_AGE = 60        # 连接复用秒数（>0 必须保证 max_connections 足够）
# DATABASES_CONNECT_TIMEOUT = 5      # 建连超时（秒）

## 密钥配置
SECRET_KEY = ''

## 进程模型 / 多核吞吐（可选，默认见 settings/base.py）
# WEB_CONCURRENCY = 1                # web worker 进程数；scripts/run_servers.py 启动时自动写入
# DB_MAX_CONCURRENT_REQUESTS = 32    # 全局并发预算（所有 worker 合计）；按 worker 数分摊到进程内
# DB_BACKPRESSURE_TIMEOUT = 10       # 超并发排队上限（秒），超时 503 + Retry-After

## WebSocket 推送通道层（可选）
# CHANNEL_LAYER_BACKEND = postgres   # postgres（默认，跨进程，零新增中间件）| redis | memory
# CHANNEL_POLL_INTERVAL = 0.1        # postgres 层推送拉取间隔（秒），推送延迟 ≤ 该值
# REDIS_URL = redis://127.0.0.1:6379/0   # 仅 CHANNEL_LAYER_BACKEND=redis 时需要
