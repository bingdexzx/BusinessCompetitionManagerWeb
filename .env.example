## ============================================================================
## 商赛辅助办赛系统 —— 环境配置示例
## ----------------------------------------------------------------------------
## 用法：复制为 .env（同名同目录），按需修改后重启服务。
##   PowerShell: Copy-Item .env.example .env
## 说明：
##   - 值统一用单引号包裹（字符串），数字/布尔也按字符串写，程序内部会转换；
##   - 改完 .env 必须重启后端（scripts\run_servers.py）才生效；
##   - 带「安全」标记的项在生产环境必须按说明设置。
## ============================================================================


## ============================================================================
## 1. 应用
## ============================================================================

# 应用版本号：仅用于展示 / 健康检查 / 更新日志比对，不参与业务逻辑。
# 默认：1.0.0
APP_VERSION = '1.0.0'

# 调试模式：true 时返回报错堆栈、放宽 ALLOWED_HOSTS 到 *、自动服务静态文件。
# 生产必须为 false（安全审计要求）。
# 可选：true | false；默认：false
DEBUG = 'false'


## ============================================================================
## 2. 数据库（PostgreSQL）
## ============================================================================

# 全局库名（比赛数据在各自独立的 comp_<id> 库，无需在这里配置）。
# 默认：business_competition_manager
DATABASES_NAME = 'business_competition_manager'

# 数据库账号：生产建议使用独立账号（非 postgres 超级用户），只授予所需库权限。
# 默认：postgres
DATABASES_USER = 'postgres'

# 数据库密码：含特殊字符时务必用单引号包裹。
DATABASES_PASSWORD = ''

# 数据库主机：本机填 localhost；接入 PgBouncer 时这里填 PgBouncer 的地址。
# 默认：localhost
DATABASES_HOST = 'localhost'

# 数据库端口：直连 PostgreSQL 为 5432；接 PgBouncer 时改为 6432。
# 默认：5432
DATABASES_PORT = '5432'

# 连接复用秒数：>0 时长连接复用（避免每请求 ~44ms 建连）；
# 前提是 PostgreSQL 的 max_connections 足够（≥ 2 × 并发线程数 + 余量）。
# 0 = 每次请求新建连接（不推荐）。默认：60
DATABASES_CONN_MAX_AGE = '60'

# 建连超时（秒）：数据库不可用时快速失败，避免请求线程堆积。
# 默认：5
DATABASES_CONNECT_TIMEOUT = '5'
# 走 PgBouncer transaction pooling 时设为 true（Django 会禁用服务端游标）。
DATABASES_DISABLE_SERVER_SIDE_CURSORS = 'false'


## ============================================================================
## 3. 密钥（安全）
## ============================================================================

# 签名/加密密钥（JWT、会话、密码重置等）。
# 要求：≥32 字符的随机字符串；非 DEBUG 下如果为空、过短或以 django-insecure- 开头，
#       服务会拒绝启动。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：轮换后所有已签发的登录令牌失效，用户需要重新登录。
SECRET_KEY = ''


## ============================================================================
## 4. 域名 / CORS / 安全响应头
## ============================================================================

# 允许访问的 Host（逗号分隔）。DEBUG=false 时必须显式配置，否则只允许 localhost。
# 例：example.com,www.example.com；纯 IP 部署填服务器 IP，如 203.0.113.10
# 默认：localhost,127.0.0.1
ALLOWED_HOSTS = 'localhost,127.0.0.1'

# 允许跨域的前端来源（逗号分隔，需要带协议与端口，不能用 *）。
# 默认：http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS = 'http://localhost:5173,http://127.0.0.1:5173'

# 允许的 CSRF 受信来源（逗号分隔）：仅在 HTTPS + 独立域名部署时需要。
# 例：https://example.com
CSRF_TRUSTED_ORIGINS = ''

# 是否允许被 iframe 嵌入：DENY（推荐）| SAMEORIGIN。
# 默认：DENY
X_FRAME_OPTIONS = 'DENY'

# Referrer 策略：same-origin（推荐）| no-referrer | strict-origin-when-cross-origin。
# 默认：same-origin
SECURE_REFERRER_POLICY = 'same-origin'

# 是否把 HTTP 强制跳转 HTTPS：只在启用 HTTPS 后开启（true|false）。
# 默认：false
SECURE_SSL_REDIRECT = 'false'

# HSTS 生效秒数：HTTPS 稳定后再开（首次建议 3600，逐步到 31536000）。
# 0 = 关闭。默认：0
SECURE_HSTS_SECONDS = '0'

# 是否申请 HSTS 预加载列表（浏览器内置强制 HTTPS）：确认全站 HTTPS 后再开。
# 默认：false
SECURE_HSTS_PRELOAD = 'false'

# 是否信任反向代理传来的 X-Forwarded-For：
# 只有确认请求一定经过自己的反向代理时才开；否则客户端可伪造 IP 绕过登录限流。
# 默认：false
TRUST_X_FORWARDED_FOR = 'false'

# 是否信任反向代理传来的 X-Forwarded-Proto（用于识别 HTTPS）：
# 反向代理终止 TLS 时开启。默认：false
TRUST_X_FORWARDED_PROTO = 'false'

# 会话 / CSRF Cookie 是否只通过 HTTPS 传输：HTTPS 部署时 true。
# 默认：非 DEBUG 时 true（本地纯 HTTP 调试可改 false）
SESSION_COOKIE_SECURE = 'true'
CSRF_COOKIE_SECURE = 'true'


## ============================================================================
## 5. 进程模型 / 数据库并发
## ============================================================================

# HTTP worker 进程数（waitress prefork）：一般 = CPU 核数或略少。
# 由 scripts\run_servers.py 启动时会用命令行参数覆盖。
# 默认：1
WEB_CONCURRENCY = '4'

# 全局数据库并发请求预算（所有 worker 合计）：超出后排队，防止打满数据库连接。
# 经验值：≥ worker × 线程 × 2 时连接够用；默认 32 在 4 worker 下偏保守。
# 默认：32
DB_MAX_CONCURRENT_REQUESTS = '64'

# 超并发时的排队上限（秒）：排队超时返回 503 + Retry-After，避免雪崩。
# 默认：10
DB_BACKPRESSURE_TIMEOUT = '10'


## ============================================================================
## 6. WebSocket 通道层 / 缓存
## ============================================================================

# 跨进程推送通道层：postgres（默认，零新增中间件）| memory（仅单进程开发）| redis。
CHANNEL_LAYER_BACKEND = 'postgres'

# postgres 通道层的拉取间隔（秒）：推送延迟 ≤ 该值；0.1 足够（客户端还有 1.5s 去抖）。
# 默认：0.1
CHANNEL_POLL_INTERVAL = '0.1'

# 仅 CHANNEL_LAYER_BACKEND=redis 时需要：Redis 连接串。
# REDIS_URL = 'redis://127.0.0.1:6379/0'

# 缓存默认过期时间（秒）：单个缓存点未指定 TTL 时使用。默认：300
CACHE_DEFAULT_TIMEOUT = '300'

# 合同类型 schema 缓存（每个类型要读插件文件，很贵）：导入新包自动失效。
# 默认：600
CACHE_TTL_CONTRACT_TYPES = '600'

# 公司列表缓存（按可见范围）：公司/队伍变更时失效。默认：15
CACHE_TTL_COMPANY_LIST = '15'

# 基础数据列表缓存（数据管理/合同下拉）：写操作时失效。默认：20
CACHE_TTL_BASEDATA = '20'

# 产业字段定义缓存：比赛包导入后失效。默认：60
CACHE_TTL_INDUSTRY_FIELDS = '60'


## ============================================================================
## 7. 登录限流 / 日志留存
## ============================================================================

# 同一「用户名|IP」在窗口内失败多少次后锁定账号。默认：10
LOGIN_FAIL_LIMIT = '10'

# 失败计数窗口（秒）。默认：300（5 分钟）
LOGIN_FAIL_WINDOW_SECONDS = '300'

# 触发后的锁定时长（秒）。默认：900（15 分钟）
LOGIN_LOCK_SECONDS = '900'

# 网络日志里请求/响应摘要的最大字符数：越小日志表越小。默认：2000
LOG_DIGEST_MAX_LENGTH = '2000'

# 网络日志异步批量写（1=开，0=同步写；默认开）
NETWORK_LOG_ASYNC = '1'

# 网络日志留存天数（prune_network_logs 默认值；0 = 不限）。默认：30
NETWORK_LOG_RETENTION_DAYS = '30'

# 网络日志最多保留条数（超出从最旧开始删；0 = 不限）。默认：200000
NETWORK_LOG_KEEP_ROWS = '200000'

# 资源变更广播流水留存天数（断线重放用；超过窗口客户端会自行全量刷新）。默认：7
BROADCAST_EVENT_RETENTION_DAYS = '7'

# 广播流水最多保留条数。默认：100000
BROADCAST_EVENT_KEEP_ROWS = '100000'


## ============================================================================
## 8. 上传 / 比赛包导入
## ============================================================================

# 通用文件上传体积上限（字节）。默认：104857600（100MB）
UPLOAD_MAX_BYTES = '104857600'

# 站内信/帖子图片体积上限（字节）。默认：5242880（5MB）
MESSAGE_IMAGE_MAX_BYTES = '5242880'

# 允许上传的扩展名（逗号分隔，不含点）。
# 默认：png,jpg,jpeg,gif,webp,pdf,xlsx,csv,zip,txt,md
UPLOAD_ALLOWED_EXTENSIONS = 'png,jpg,jpeg,gif,webp,pdf,xlsx,csv,zip,txt,md'

# 比赛包 zip 上传体积上限（字节）。默认：104857600（100MB）
PACKAGE_MAX_BYTES = '104857600'

# 比赛包解压后允许的最大文件数（防 zip 炸弹）。默认：3000
PACKAGE_MAX_FILES = '3000'

# 比赛包解压后允许的最大总体积（字节）。默认：314572800（300MB）
PACKAGE_MAX_UNCOMPRESSED_BYTES = '314572800'


## ============================================================================
## 9. 合同
## ============================================================================

# 合同列表默认每页条数。默认：50
CONTRACT_PAGE_SIZE = '50'

# 合同列表每页条数上限（防止一次拉太多）。默认：200
CONTRACT_PAGE_SIZE_MAX = '200'

# 合同增量同步默认每次条数。默认：500
CONTRACT_SYNC_LIMIT = '500'

# 合同增量同步每次上限。默认：1000
CONTRACT_SYNC_LIMIT_MAX = '1000'

# 合同详情返回的时间线条数上限（多轮修改的合同会很长）。默认：300
CONTRACT_TIMELINE_MAX = '300'

# 合同详情返回的检查记录条数上限。默认：200
CONTRACT_CHECKS_MAX = '200'

# 修改申请/补录审核超过多少小时未处理算「超时」并催办。默认：24
CONTRACT_OVERDUE_HOURS = '24'

# 合同修改期间资源冻结的兜底超时（小时）：超过后自动解冻，避免卡死。默认：24
CONTRACT_FREEZE_TIMEOUT_HOURS = '24'


## ============================================================================
## 10. 基础数据 / 工具箱
## ============================================================================

# 数据管理列表默认每页条数。默认：200
BASEDATA_PAGE_SIZE = '200'

# 数据管理列表每页上限。默认：500
BASEDATA_PAGE_SIZE_MAX = '500'

# 计时器允许设置的最长时长（天）。默认：30
TIMER_MAX_DURATION_DAYS = '30'
